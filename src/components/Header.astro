---
import { languages, langs, type Lang } from "../i18n/ui";
import { localePath, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  section?: "projects" | "stories" | "books";
  /** Float transparently over a dark hero until the reader scrolls. */
  overlay?: boolean;
}
const { lang, alternates, section, overlay = false } = Astro.props;
const t = useTranslations(lang);
const nav = [
  { key: "projects", label: t("nav.projects"), href: localePath(lang, "projects") },
  { key: "stories", label: t("nav.stories"), href: localePath(lang, "stories") },
  { key: "books", label: t("nav.books"), href: localePath(lang, "books") },
] as const;
---

<header class:list={["site-header", { "is-overlay": overlay }]} data-header>
  <div class="wrap flex h-16 items-center gap-6">
    <a href={localePath(lang)} class="brand no-underline">
      <span class="brand-dot" aria-hidden="true"></span>
      {t("site.title")}
    </a>
    <nav aria-label="Main" class="ml-auto">
      <ul class="flex items-center gap-1 sm:gap-5">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="nav-link" aria-current={section === item.key ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ul class="flex items-center" aria-label={t("lang.label")}>
      {
        langs.map((l) => (
          <li>
            <a href={alternates[l]} hreflang={l} lang={l} class="lang-link" aria-current={l === lang ? "true" : undefined} title={languages[l]}>
              {l}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={`${localePath(lang)}#contact`} class="contact-link max-md:hidden">{t("nav.contact")}</a>
  </div>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: #f4f4f2;
    background: rgb(0 0 0 / 0.9);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    font-size: 0.92rem;
    transition:
      background-color 0.4s,
      border-color 0.4s;
  }
  /* Over a full-bleed hero the header takes no space and starts transparent. */
  .site-header.is-overlay {
    position: fixed;
    inset: 0 0 auto;
  }
  .site-header.is-overlay:not(.is-scrolled) {
    background: transparent;
    backdrop-filter: none;
    border-color: transparent;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 560;
    font-variation-settings: "wdth" 85;
    letter-spacing: -0.01em;
    font-size: 1.02rem;
    white-space: nowrap;
  }
  .brand-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 12px var(--signal);
  }
  .nav-link,
  .lang-link {
    display: inline-block;
    padding: 0.35rem 0.4rem;
    color: rgb(244 244 242 / 0.7);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover,
  .lang-link:hover,
  .nav-link[aria-current="page"],
  .lang-link[aria-current="true"] {
    color: #fff;
  }
  .nav-link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  .lang-link {
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    padding-inline: 0.3rem;
  }
  .contact-link {
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: #f4f4f2;
    color: #000;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .contact-link:hover {
    background: var(--signal);
  }
  @media (max-width: 560px) {
    .brand {
      font-size: 0;
      gap: 0;
    }
    .nav-link {
      padding-inline: 0.3rem;
      font-size: 0.86rem;
    }
  }
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
</style>

<script>
  import { ScrollTrigger } from "../scripts/motion";

  for (const a of document.querySelectorAll<HTMLAnchorElement>("a[hreflang]"))
    a.addEventListener("click", () => {
      try {
        localStorage.setItem("lang", a.hreflang);
      } catch {}
    });

  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const bar = header.querySelector<HTMLElement>("[data-progress]")!;
  ScrollTrigger.create({
    start: 80,
    end: "max",
    onToggle: (self) => header.classList.toggle("is-scrolled", self.isActive),
  });
  // Reading progress only on pages that mark their article.
  const article = document.querySelector<HTMLElement>("[data-reading]");
  if (article)
    ScrollTrigger.create({
      trigger: article,
      start: "top top",
      end: "bottom bottom",
      onUpdate: (self) => (bar.style.transform = `scaleX(${self.progress})`),
    });
</script>
