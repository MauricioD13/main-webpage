---
// The book's table of contents: roman numeral, title, dotted leader, period.
import type { CollectionEntry } from "astro:content";
import type { Lang } from "../i18n/ui";
import { entrySlug, localePath, useTranslations } from "../i18n/utils";
import { toRoman } from "../lib/roman";

interface Props {
  lang: Lang;
  items: { entry: CollectionEntry<"chapters">; fallback: boolean }[];
  /** Show subtitles under titles. */
  detailed?: boolean;
}
const { lang, items, detailed = false } = Astro.props;
const t = useTranslations(lang);
---

<ol class="contents">
  {
    items.map(({ entry, fallback }) => (
      <li data-toc-item={entry.data.translationKey}>
        <a href={localePath(lang, `chapters/${entrySlug(entry.id)}`)} class="toc-link">
          <span class="toc-num display" aria-hidden="true">{toRoman(entry.data.chapter)}</span>
          <span class="toc-main">
            <span class="toc-line">
              <span class="toc-title">{entry.data.title}</span>
              <span class="toc-leader" aria-hidden="true" />
              <span class="toc-period ui">{entry.data.period}</span>
            </span>
            {detailed && <span class="toc-sub">{entry.data.subtitle}</span>}
            {fallback && <span class="toc-badge ui">{t("fallback.badge")}</span>}
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .contents {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc-link {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.85rem 0;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  li:first-child .toc-link {
    border-top: 1px solid var(--rule);
  }
  .toc-num {
    font-size: 1.35rem;
    color: var(--accent);
    font-weight: 300;
    line-height: 1.3;
  }
  .toc-line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .toc-title {
    font-size: 1.2rem;
    line-height: 1.3;
    text-wrap: balance;
  }
  .toc-leader {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1.5px dotted var(--rule);
    transform: translateY(-0.3em);
  }
  .toc-period {
    font-size: 0.82rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .toc-sub {
    display: block;
    margin-top: 0.3rem;
    color: var(--ink-soft);
    font-style: italic;
    line-height: 1.45;
    max-width: 34rem;
  }
  .toc-badge {
    display: inline-block;
    margin-top: 0.45rem;
    font-size: 0.72rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink-soft);
  }
  .toc-link:hover .toc-title,
  .toc-link:focus-visible .toc-title {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  :global(li.is-current) .toc-num {
    color: var(--ink);
  }
</style>
