---
// A project as a large dark media card: the project's architecture as line-art (or its
// cover photo), tags, title and a round arrow.
import type { CollectionEntry } from "astro:content";
import ArchDiagram from "./visual/ArchDiagram.astro";
import MonoImage from "./MonoImage.astro";
import { projectPlates } from "../data/diagrams";
import { projectPlatesEs } from "../data/diagrams.es";
import type { Lang } from "../i18n/ui";
import { entrySlug, localePath, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  entry: CollectionEntry<"projects">;
  fallback?: boolean;
  feature?: boolean;
}
const { lang, entry, fallback = false, feature = false } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
const plate = projectPlates[d.translationKey as keyof typeof projectPlates];
const href = localePath(lang, `projects/${entrySlug(entry.id)}`);
---

<a href={href} class:list={["project-card", { feature }]} data-project={entrySlug(entry.id)}>
  <div class="media" aria-hidden="true">
    {
      plate ? (
        <ArchDiagram diagram={plate} title={d.title} interactive={false} i18n={lang === "es" ? projectPlatesEs[d.translationKey] : undefined} />
      ) : d.cover ? (
        <MonoImage src={d.cover} alt="" class="h-full w-full" />
      ) : (
        <span class="media-word display">{d.stack[0]}</span>
      )
    }
  </div>
  <div class="meta">
    <ul class="tags">
      <li class="pill">{d.period}</li>
      {d.stack.slice(0, feature ? 4 : 2).map((s) => <li class="pill">{s}</li>)}
      {fallback && <li class="pill">{t("fallback.badge")}</li>}
    </ul>
    <div class="title-row">
      <div>
        <h3 class="display title">{d.title}</h3>
        <p class="subtitle">{d.subtitle}</p>
      </div>
      <span class="arrow" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </span>
    </div>
  </div>
</a>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-card);
    background: var(--raised);
    color: #f4f4f2;
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07);
  }
  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #000;
    display: grid;
    place-items: center;
  }
  .feature .media {
    aspect-ratio: 16 / 9;
  }
  @media (min-width: 1024px) {
    .feature .media {
      aspect-ratio: 21 / 9;
    }
  }
  /* The line-art fills the media area, monochrome until hover. */
  .media :global(.plate) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    border-radius: 0;
    box-shadow: none;
    padding: 4% 7%;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Fit the whole diagram inside the frame (the SVG keeps its aspect ratio, centred). */
  .media :global(.plate-svg) {
    flex: 1;
    width: 100%;
    min-height: 0;
  }
  .media :global(.d-icon) {
    filter: grayscale(1) brightness(1.5) contrast(0.95);
    transition: filter 0.6s ease;
  }
  .project-card:hover .media :global(.plate),
  .project-card:focus-visible .media :global(.plate) {
    transform: scale(1.04);
  }
  .project-card:hover .media :global(.d-icon),
  .project-card:focus-visible .media :global(.d-icon) {
    filter: none;
  }
  .media-word {
    font-size: clamp(2.4rem, 6vw, 5rem);
    color: rgb(255 255 255 / 0.85);
    padding: 1rem;
    text-align: center;
  }
  .meta {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.1rem;
    padding: 1.4rem 1.5rem 1.6rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    --line: rgb(255 255 255 / 0.18);
    --fg: #e8e8e6;
  }
  .title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .title {
    font-size: clamp(1.6rem, 2.4vw, 2.3rem);
    line-height: 1;
  }
  .feature .title {
    font-size: clamp(2rem, 3.6vw, 3.4rem);
  }
  .subtitle {
    margin-top: 0.55rem;
    color: #9a9a96;
    line-height: 1.45;
    max-width: 42rem;
  }
  .arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.22);
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.3s;
  }
  .project-card:hover .arrow,
  .project-card:focus-visible .arrow {
    background: var(--signal);
    border-color: var(--signal);
    color: #000;
    transform: translateX(4px);
  }
</style>

<script>
  const posthog = (window as Window & { posthog?: { capture: (event: string, properties?: Record<string, string>) => void } }).posthog;

  for (const card of document.querySelectorAll<HTMLAnchorElement>("[data-project]"))
    card.addEventListener("click", () => {
      posthog?.capture("project_opened", { project_slug: card.dataset.project! });
    });
</script>
