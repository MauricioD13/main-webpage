---
import type { CollectionEntry } from "astro:content";
import Cyanotype from "./Cyanotype.astro";
import type { Lang } from "../i18n/ui";
import { entrySlug, formatDate, localePath, readingMinutes, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  items: { entry: CollectionEntry<"stories">; fallback: boolean }[];
}
const { lang, items } = Astro.props;
const t = useTranslations(lang);
---

<ol class="stories">
  {
    items.map(({ entry, fallback }) => (
      <li>
        <a href={localePath(lang, `stories/${entrySlug(entry.id)}`)} class="story">
          <time class="story-date ui" datetime={entry.data.date.toISOString()}>
            {formatDate(entry.data.date, lang, { day: "numeric" })}
          </time>
          <span class="story-main">
            <span class="story-title">{entry.data.title}</span>
            <span class="story-desc">{entry.data.description}</span>
            <span class="story-meta ui">
              {readingMinutes(entry.body)} {t("stories.read")}
              {fallback && <span class="badge">{t("fallback.badge")}</span>}
            </span>
          </span>
          {entry.data.cover && <Cyanotype src={entry.data.cover} alt="" class="story-thumb" widths={[160, 320]} sizes="160px" />}
        </a>
      </li>
    ))
  }
</ol>

<style>
  .stories {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5.5rem;
    gap: 0.4rem 1.25rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }
  li:first-child .story {
    border-top: 1px solid var(--rule);
  }
  .story-date {
    grid-column: 1 / -1;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  .story-main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .story-title {
    font-size: 1.35rem;
    line-height: 1.25;
    text-wrap: balance;
  }
  .story-desc {
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .story-meta {
    font-size: 0.8rem;
    color: var(--ink-soft);
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .badge {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
  }
  .story :global(.story-thumb) {
    width: 5.5rem;
    aspect-ratio: 1;
    border-radius: 3px;
    align-self: start;
  }
  .story:hover .story-title {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  @media (min-width: 768px) {
    .story {
      grid-template-columns: 9rem minmax(0, 1fr) 7rem;
    }
    .story-date {
      grid-column: auto;
      padding-top: 0.35rem;
    }
    .story :global(.story-thumb) {
      width: 7rem;
    }
  }
</style>
