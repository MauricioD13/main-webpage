---
import type { CollectionEntry } from "astro:content";
import MonoImage from "./MonoImage.astro";
import type { Lang } from "../i18n/ui";
import { entrySlug, formatDate, localePath, readingMinutes, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  items: { entry: CollectionEntry<"stories">; fallback: boolean }[];
}
const { lang, items } = Astro.props;
const t = useTranslations(lang);
---

<ol class="stories">
  {
    items.map(({ entry, fallback }) => (
      <li>
        <a href={localePath(lang, `stories/${entrySlug(entry.id)}`)} class="story">
          {entry.data.cover && <MonoImage src={entry.data.cover} alt="" class="thumb" widths={[240, 480]} sizes="240px" />}
          <span class="main">
            <span class="meta label">
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang, { day: "numeric" })}</time>
              <span>
                {readingMinutes(entry.body)} {t("stories.read")}
              </span>
              {fallback && <span class="pill">{t("fallback.badge")}</span>}
            </span>
            <span class="title display">{entry.data.title}</span>
            <span class="desc">{entry.data.description}</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .stories {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .story {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.4rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .story :global(.thumb) {
    width: 6rem;
    aspect-ratio: 1;
    border-radius: 14px;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
  }
  .title {
    font-size: clamp(1.45rem, 2vw, 1.9rem);
    line-height: 1.02;
  }
  .desc {
    color: var(--muted);
    line-height: 1.5;
  }
  .story:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  @media (min-width: 768px) {
    .story {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 2rem;
    }
    .story :global(.thumb) {
      width: 8.5rem;
    }
  }
</style>
