---
// One beat of a project's story. While it sits in the reading zone, the plate on the
// stage reveals `show`, highlights `focus`, and switches to `panel` if given.
interface Props {
  /** Comma-separated element ids (nodes, groups, or "from-to" edges) revealed at this step. */
  show?: string;
  /** Comma-separated ids highlighted at this step. Chart steps use data labels. */
  focus?: string;
  /** Which stage panel this step drives; defaults to the previous step's. */
  panel?: string;
}
const { show = "", focus = "", panel } = Astro.props;
---

<div class="step" data-step data-show={show} data-focus={focus} data-panel-target={panel}>
  <div class="step-body prose-site">
    <slot />
  </div>
</div>

<style>
  /*
   * Reading first: each step is one passage of the article. Steps sit close together,
   * neighbours stay readable, and the active one is marked with an amber rule.
   */
  .step {
    padding: 1.5rem 0;
  }
  .step-body > :global(*:first-child) {
    margin-top: 0;
  }
  .step-body > :global(*:last-child) {
    margin-bottom: 0;
  }
  :global([data-scrolly].is-live) .step {
    min-height: 42vh;
    display: flex;
    align-items: center;
  }
  :global([data-scrolly].is-live) .step-body {
    padding-left: 1.25rem;
    box-shadow: inset 2px 0 0 var(--line);
    transition:
      opacity 0.4s ease,
      box-shadow 0.4s ease;
    opacity: 0.55;
  }
  :global([data-scrolly].is-live) .step.is-active .step-body {
    opacity: 1;
    box-shadow: inset 2px 0 0 var(--signal);
  }
  /* The first passage starts right where the intro ends instead of mid-block. */
  .step:first-child {
    padding-top: 0;
  }
  :global([data-scrolly].is-live) .step:first-child {
    align-items: flex-start;
  }
  @media (max-width: 1023px) {
    :global([data-scrolly].is-live) .step {
      min-height: 50vh;
      align-items: flex-start;
    }
    :global([data-scrolly].is-live) .step-body {
      background: var(--bg);
      padding: 1rem 1.1rem 1rem 1.25rem;
      border-radius: 6px;
      position: relative;
      z-index: 2;
    }
  }
</style>
