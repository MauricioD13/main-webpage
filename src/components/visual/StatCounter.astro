---
// A figure that counts up from zero the first time it is scrolled into view.
interface Props {
  value: number;
  label: string;
  prefix?: string;
  suffix?: string;
  decimals?: number;
}
const { value, label, prefix = "", suffix = "", decimals = 0 } = Astro.props;
---

<div class="stat">
  <span class="stat-value display" data-count={value} data-decimals={decimals}>
    {prefix}<span class="num">{value.toFixed(decimals)}</span>{suffix}
  </span>
  <span class="stat-label ui">{label}</span>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.8rem;
    border-top: 2px solid var(--ink);
  }
  .stat-value {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .stat-label {
    font-size: 0.86rem;
    color: var(--ink-soft);
    line-height: 1.35;
  }
</style>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from "../../scripts/motion";

  if (!reducedMotion()) {
    for (const el of document.querySelectorAll<HTMLElement>("[data-count]")) {
      const num = el.querySelector<HTMLElement>(".num")!;
      const target = Number(el.dataset.count);
      const decimals = Number(el.dataset.decimals ?? 0);
      const state = { v: 0 };
      num.textContent = (0).toFixed(decimals);
      ScrollTrigger.create({
        trigger: el,
        start: "top 85%",
        once: true,
        onEnter: () =>
          gsap.to(state, {
            v: target,
            duration: 1.6,
            ease: "power2.out",
            onUpdate: () => (num.textContent = state.v.toFixed(decimals)),
          }),
      });
    }
  }
</script>
