---
// A margin note: the aside a reader would pencil next to the paragraph.
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<aside class="callout not-prose">
  {title && <p class="callout-title ui">{title}</p>}
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    margin: 2rem 0;
    padding: 0.2rem 0 0.2rem 1.1rem;
    border-left: 3px solid var(--signal);
    color: var(--ink);
  }
  .callout-title {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .callout-body {
    font-size: 0.98rem;
    line-height: 1.65;
    font-style: italic;
  }
  .callout-body :global(p + p) {
    margin-top: 0.7rem;
  }
</style>
