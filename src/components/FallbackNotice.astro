---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
---

<p class="my-6 max-w-xl border-l-2 border-signal py-1 pl-3 text-sm text-muted" lang={Astro.props.lang}>
  {t("fallback.notice")}
</p>
