---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
---

<p class="ui my-6 border-l-[3px] border-signal py-1 pl-3 text-sm text-ink-soft" lang={Astro.props.lang}>
  {t("fallback.notice")}
</p>
