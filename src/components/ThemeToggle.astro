---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label={label} title={label}>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <!-- A reading lamp: the shade fills in at night. -->
    <path class="shade" d="M7 4h10l3 7H4z"></path>
    <path d="M12 11v8M8 20h8"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--ink-soft);
    border-radius: 3px;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--ink);
  }
  .shade {
    fill: transparent;
    transition: fill 0.3s;
  }
  :global([data-theme="night"]) .shade {
    fill: var(--signal);
    stroke: var(--signal);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="day"])) .shade {
      fill: var(--signal);
      stroke: var(--signal);
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
  const root = document.documentElement;
  const isNight = () =>
    root.dataset.theme === "night" ||
    (!root.dataset.theme && window.matchMedia("(prefers-color-scheme: dark)").matches);
  const sync = () => btn.setAttribute("aria-pressed", String(isNight()));
  sync();
  btn.addEventListener("click", () => {
    const next = isNight() ? "day" : "night";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    sync();
  });
</script>
