---
// A slow band of the services this work runs on, in monochrome.
import { awsIcons, type AwsIconKey } from "./visual/icons";

const items: { icon: AwsIconKey; label: string }[] = [
  { icon: "ec2", label: "EC2" },
  { icon: "ecs", label: "ECS" },
  { icon: "lambda", label: "Lambda" },
  { icon: "s3", label: "S3" },
  { icon: "rds", label: "RDS" },
  { icon: "alb", label: "Load balancing" },
  { icon: "waf", label: "WAF" },
  { icon: "iam", label: "IAM" },
  { icon: "cloudwatch", label: "CloudWatch" },
  { icon: "eventbridge", label: "EventBridge" },
  { icon: "athena", label: "Athena" },
  { icon: "ecr", label: "ECR" },
  { icon: "optimizer", label: "Compute Optimizer" },
  { icon: "ssm", label: "Parameter Store" },
];
---

<div class="marquee theme-dark" aria-label="AWS services used in these projects">
  <ul class="track">
    {
      [0, 1].map((copy) =>
        items.map(({ icon, label }) => {
          const Icon = awsIcons[icon];
          return (
            <li aria-hidden={copy === 1 ? "true" : undefined}>
              <Icon size={30} />
              <span>{label}</span>
            </li>
          );
        }),
      )
    }
  </ul>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding-block: 1.4rem;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    gap: 3.5rem;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: slide 60s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.95rem;
    white-space: nowrap;
  }
  li :global(svg) {
    border-radius: 6px;
    filter: grayscale(1) brightness(1.3);
    opacity: 0.8;
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
</style>
