---
// Prints any photo as a cyanotype: blue ground, image as luminosity. Pointer hover
// "develops" it back to full colour.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
}
const { src, alt, class: className, widths = [480, 800, 1200], sizes = "(min-width: 1024px) 40vw, 100vw", loading = "lazy" } = Astro.props;
---

<div class:list={["cyanotype", className]}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} class="h-full w-full object-cover" />
</div>

<style>
  .cyanotype {
    background: var(--plate);
    overflow: hidden;
    position: relative;
  }
  .cyanotype :global(img) {
    mix-blend-mode: luminosity;
    filter: contrast(1.15) brightness(1.05);
    opacity: 0.92;
    transition:
      mix-blend-mode 0s 0.6s,
      filter 0.6s ease,
      opacity 0.6s ease;
  }
  @media (hover: hover) {
    .cyanotype:hover :global(img) {
      mix-blend-mode: normal;
      filter: none;
      opacity: 1;
      transition:
        filter 0.6s ease,
        opacity 0.6s ease;
    }
  }
</style>
