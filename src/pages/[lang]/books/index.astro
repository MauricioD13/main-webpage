---
import Base from "../../../layouts/Base.astro";
import BookCover from "../../../components/BookCover.astro";
import Rating from "../../../components/Rating.astro";
import Headline from "../../../components/Headline.astro";
import type { Lang } from "../../../i18n/ui";
import { entrySlug, getLocalizedEntries, localePath, useTranslations } from "../../../i18n/utils";
import { localeStaticPaths } from "../../../lib/paths";
import { bookCategories, getBookColors } from "../../../lib/books";

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const statusOrder = { reading: 0, finished: 1, queued: 2 } as const;
const items = (await getLocalizedEntries("books", lang)).sort(
  (a, b) => statusOrder[a.entry.data.status] - statusOrder[b.entry.data.status] || b.entry.data.date.valueOf() - a.entry.data.date.valueOf(),
);
const shelves = bookCategories
  .map((category) => ({
    category,
    label: t(`books.${category}`),
    books: items.filter((i) => i.entry.data.category === category),
  }))
  .filter((shelf) => shelf.books.length > 0);
const color = await getBookColors();
// Spine size follows page count so the shelf looks like a real one.
const spine = (pages = 320) => ({
  h: Math.round(Math.min(300, Math.max(210, 180 + pages / 5))),
  w: Math.round(Math.min(58, Math.max(34, 22 + pages / 18))),
});
---

<Base lang={lang} title={t("nav.books")} description={t("books.lede")} alternates={{ en: localePath("en", "books"), es: localePath("es", "books") }} section="books">
  <section class="theme-dark shelf-page">
    <div class="wrap pt-20 pb-24 lg:pt-28 lg:pb-32">
      <div class="grid gap-8 lg:grid-cols-3">
        <Headline as="h1" lead={t("books.lead")} tail={t("books.tail")} class="lg:col-span-2" size="clamp(3rem, 8vw, 8rem)" />
        <p class="lede self-end">{t("books.lede")}</p>
      </div>

    {
      items.length === 0 ? (
        <p class="lede mt-20 border-y border-line py-12">{t("books.empty")}</p>
      ) : (
        <>
          <div class="filters mt-14" role="group" aria-label={t("books.filter")} data-filters hidden>
            {(["all", ...shelves.map((s) => s.category)] as const).map((f, i) => (
              <button type="button" data-filter={f} aria-pressed={i === 0 ? "true" : "false"}>
                {t(`books.${f}`)}
              </button>
            ))}
          </div>

          <div class="shelves mt-10">
          {shelves.map((shelf) => (
            <section class="shelf-block" data-shelf={shelf.category} aria-labelledby={`shelf-${shelf.category}`}>
              <h2 id={`shelf-${shelf.category}`} class="label">
                {shelf.label}
              </h2>
              <ul class="shelf">
                {shelf.books.map(({ entry }) => {
                  const d = entry.data;
                  const s = spine(d.book.pages);
                  return (
                    <li class="spine-wrap">
                      <a
                        href={localePath(lang, `books/${entrySlug(entry.id)}`)}
                        class="spine"
                        style={`--h:${s.h}px;--w:${s.w}px;--cloth:${color(d.translationKey)}`}
                        data-book={entry.id}
                        aria-describedby={`status-${entry.id.replace("/", "-")}`}
                      >
                        <span class="spine-title">{d.book.title}</span>
                        <span class="spine-author">{d.book.author.split(",")[0]}</span>
                        {d.status === "reading" && <span class="bookmark" aria-hidden="true" />}
                      </a>
                      <span id={`status-${entry.id.replace("/", "-")}`} class="sr-only">
                        {t(`books.${d.status}`)}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
          </div>

          {items.map(({ entry }) => {
            const d = entry.data;
            return (
              <template data-detail={entry.id}>
                <div class="pulled">
                  <BookCover book={d.book} color={color(d.translationKey)} class="pulled-cover" />
                  <div class="pulled-body">
                    <p class="pill">{t(`books.${d.status}`)}</p>
                    <h3 class="display mt-4 text-[clamp(2rem,3.4vw,3rem)]">{d.book.title}</h3>
                    <p class="display-serif mt-2 text-2xl text-muted">
                      {t("books.by")} {d.book.author}
                      {d.book.year && `, ${d.book.year}`}
                    </p>
                    {d.rating !== undefined && (
                      <p class="mt-4 flex items-center gap-2 text-sm">
                        <Rating value={d.rating} label={t("books.rating")} />
                      </p>
                    )}
                    {d.takeaways.length > 0 && (
                      <ul class="mt-5 list-disc space-y-1.5 pl-5 leading-relaxed text-muted">
                        {d.takeaways.slice(0, 3).map((k) => (
                          <li>{k}</li>
                        ))}
                      </ul>
                    )}
                    <div class="mt-8 flex flex-wrap items-center gap-3">
                      <a href={localePath(lang, `books/${entrySlug(entry.id)}`)} class="btn btn-primary">
                        {t("books.open")}
                      </a>
                      <button type="button" data-close class="btn btn-ghost">
                        {t("books.close")}
                      </button>
                    </div>
                  </div>
                </div>
              </template>
            );
          })}
          <div class="detail mt-12" data-detail-slot aria-live="polite" />
        </>
      )
    }
    </div>
  </section>
</Base>

<style>
  .shelf-page {
    background:
      radial-gradient(70% 50% at 50% 100%, rgb(255 255 255 / 0.05), transparent 70%),
      var(--void);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .filters[hidden] {
    display: none;
  }
  .filters button {
    padding: 0.45rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .filters button:hover {
    color: var(--fg);
  }
  .filters button[aria-pressed="true"] {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  /* The shelf: spines stand on a thin lit edge, with light falling from above. */
  .shelves {
    display: grid;
    gap: 3.5rem 3rem;
  }
  @media (min-width: 1024px) {
    .shelves {
      grid-template-columns: 1fr 1fr;
    }
  }
  .shelf {
    list-style: none;
    margin: 1rem 0 0;
    padding: 28px 0.5rem 0;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    min-height: 340px;
    position: relative;
    perspective: 1000px;
    overflow-x: auto;
    border-bottom: 1px solid rgb(255 255 255 / 0.55);
  }
  /* Light pooling on the shelf edge. */
  .shelf-block {
    position: relative;
  }
  .shelf-block::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -18px;
    height: 36px;
    background: radial-gradient(50% 50% at 50% 50%, rgb(255 255 255 / 0.1), transparent 70%);
    pointer-events: none;
  }
  .spine {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    width: var(--w);
    height: var(--h);
    padding: 1rem 0 0.9rem;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.16), transparent 30%),
      linear-gradient(90deg, rgb(0 0 0 / 0.35), transparent 22%, transparent 78%, rgb(0 0 0 / 0.4)),
      color-mix(in srgb, var(--cloth) 70%, #000);
    color: #f4f4f2;
    border-radius: 10px 10px 2px 2px;
    text-decoration: none;
    transform-origin: 50% 100%;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.45s,
      filter 0.45s;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    filter: saturate(0.55);
  }
  /* Spines read top to bottom, as on most English-language books. */
  .spine-title {
    writing-mode: vertical-rl;
    font-family: var(--font-sans);
    font-variation-settings: "wdth" 80;
    font-weight: 500;
    font-size: 0.86rem;
    line-height: 1.15;
    max-height: calc(var(--h) - 5.5rem);
    max-width: calc(var(--w) - 8px);
    overflow: hidden;
    text-wrap: balance;
  }
  .spine-author {
    writing-mode: vertical-rl;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.78rem;
    opacity: 0.75;
    white-space: nowrap;
    max-height: 4.5rem;
    overflow: hidden;
  }
  .bookmark {
    position: absolute;
    top: -16px;
    left: 50%;
    width: 8px;
    height: 28px;
    margin-left: -4px;
    background: var(--signal);
    box-shadow: 0 0 12px var(--signal);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
  }
  .spine:hover,
  .spine:focus-visible,
  .spine[aria-expanded="true"] {
    transform: translateY(-18px) rotateX(-6deg);
    filter: saturate(1);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.18),
      0 24px 30px -18px rgb(255 255 255 / 0.25);
  }
  .shelf-block[hidden] {
    display: none;
  }
  .detail :global(.pulled) {
    display: grid;
    gap: 2.5rem;
    padding: 2rem;
    border-radius: var(--radius-card);
    background: var(--raised);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .detail :global(.pulled-cover) {
    width: 12rem;
  }
  @media (min-width: 640px) {
    .detail :global(.pulled) {
      grid-template-columns: 12rem minmax(0, 40rem);
      padding: 2.5rem;
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from "../../../scripts/motion";

  const posthog = (window as Window & { posthog?: { capture: (event: string, properties?: Record<string, string>) => void } }).posthog;
  const slot = document.querySelector<HTMLElement>("[data-detail-slot]");
  const filters = document.querySelector<HTMLElement>("[data-filters]");

  if (slot) {
    let open: HTMLAnchorElement | null = null;
    const close = () => {
      open?.setAttribute("aria-expanded", "false");
      open?.focus();
      open = null;
      slot.replaceChildren();
    };
    for (const spine of document.querySelectorAll<HTMLAnchorElement>("[data-book]")) {
      spine.setAttribute("aria-expanded", "false");
      spine.addEventListener("click", (e) => {
        e.preventDefault();
        if (open === spine) return close();
        open?.setAttribute("aria-expanded", "false");
        open = spine;
        spine.setAttribute("aria-expanded", "true");
        const tpl = document.querySelector<HTMLTemplateElement>(`template[data-detail="${spine.dataset.book}"]`)!;
        slot.replaceChildren(tpl.content.cloneNode(true));
        slot.querySelector("[data-close]")?.addEventListener("click", close);
        // The book slides off the shelf: cover rises from where the spine was.
        if (!reducedMotion()) {
          gsap.from(slot.querySelector(".pulled-cover"), { y: -40, rotationY: -70, opacity: 0, transformPerspective: 800, transformOrigin: "0% 50%", duration: 0.6, ease: "power3.out" });
          gsap.from(slot.querySelector(".pulled-body"), { opacity: 0, x: 16, duration: 0.5, delay: 0.15 });
        }
        // Only follow real clicks; the first book opens on load without moving the page.
        if (e.isTrusted) {
          posthog?.capture("book_preview_opened", { book_id: spine.dataset.book! });
          slot.scrollIntoView({ block: "nearest", behavior: reducedMotion() ? "auto" : "smooth" });
        }
      });
    }
  }

  document.querySelector<HTMLAnchorElement>("[data-book]")?.dispatchEvent(new MouseEvent("click", { cancelable: true }));

  if (filters) {
    filters.hidden = false;
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        const f = btn.dataset.filter;
        if (f) posthog?.capture("book_filter_selected", { category: f });
        document.querySelectorAll<HTMLElement>("[data-shelf]").forEach((s) => (s.hidden = f !== "all" && s.dataset.shelf !== f));
      });
    }
  }
</script>
