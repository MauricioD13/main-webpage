---
import Base from "../../../layouts/Base.astro";
import Headline from "../../../components/Headline.astro";
import ProjectGrid from "../../../components/ProjectGrid.astro";
import type { Lang } from "../../../i18n/ui";
import { getLocalizedEntries, localePath, useTranslations } from "../../../i18n/utils";
import { localeStaticPaths } from "../../../lib/paths";

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const items = (await getLocalizedEntries("projects", lang)).sort((a, b) => a.entry.data.order - b.entry.data.order);
---

<Base lang={lang} title={t("nav.projects")} description={t("projects.lede")} alternates={{ en: localePath("en", "projects"), es: localePath("es", "projects") }} section="projects">
  <section class="theme-dark">
    <div class="wrap pt-20 pb-24 lg:pt-28 lg:pb-36">
      <div class="mb-16 grid gap-8 lg:grid-cols-3">
        <Headline as="h1" lead={t("projects.lead")} tail={t("projects.tail")} class="lg:col-span-2" size="clamp(3rem, 8vw, 8rem)" />
        <p class="lede self-end">{t("projects.lede")}</p>
      </div>
      <ProjectGrid lang={lang} items={items} />
    </div>
  </section>
</Base>
