---
import Base from "../../../layouts/Base.astro";
import ContentsList from "../../../components/ContentsList.astro";
import ArchDiagram from "../../../components/visual/ArchDiagram.astro";
import { chapterPlates } from "../../../data/diagrams";
import type { Lang } from "../../../i18n/ui";
import { getLocalizedEntries, localePath, useTranslations } from "../../../i18n/utils";
import { localeStaticPaths } from "../../../lib/paths";

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const items = (await getLocalizedEntries("chapters", lang)).sort((a, b) => a.entry.data.chapter - b.entry.data.chapter);
const previews = items
  .map(({ entry }) => ({ key: entry.data.translationKey, title: entry.data.title, plate: chapterPlates[entry.data.translationKey as keyof typeof chapterPlates] }))
  .filter((p) => p.plate);
const alternates = { en: localePath("en", "chapters"), es: localePath("es", "chapters") };
---

<Base lang={lang} title={t("chapters.title")} description={t("chapters.lede")} alternates={alternates} section="chapters">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 pt-14 pb-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:gap-16 lg:pt-20">
    <div>
      <h1 class="display text-[clamp(2.6rem,6vw,4.4rem)]">{t("chapters.title")}</h1>
      <p class="measure mt-5 text-lg leading-relaxed text-ink-soft">{t("chapters.lede")}</p>
      <div class="mt-12">
        <ContentsList lang={lang} items={items} detailed />
      </div>
    </div>
    <aside class="max-lg:hidden" aria-hidden="true">
      <div class="preview sticky top-24" data-previews>
        {
          previews.map((p, i) => (
            <div class:list={["preview-item", { "is-active": i === 0 }]} data-preview={p.key}>
              <ArchDiagram diagram={p.plate} title={p.title} interactive={false} />
            </div>
          ))
        }
      </div>
    </aside>
  </div>
</Base>

<style>
  .preview {
    display: grid;
  }
  .preview-item {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  .preview-item.is-active {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  import { pointerTilt } from "../../../scripts/motion";

  const box = document.querySelector<HTMLElement>("[data-previews]");
  if (box) {
    pointerTilt(box, 4);
    const show = (key: string) => {
      const target = box.querySelector(`[data-preview="${key}"]`);
      if (!target) return;
      box.querySelectorAll(".preview-item").forEach((el) => el.classList.toggle("is-active", el === target));
      document.querySelectorAll("[data-toc-item]").forEach((li) => li.classList.toggle("is-current", li.getAttribute("data-toc-item") === key));
    };
    for (const li of document.querySelectorAll<HTMLElement>("[data-toc-item]")) {
      const key = li.dataset.tocItem!;
      li.addEventListener("pointerenter", () => show(key));
      li.addEventListener("focusin", () => show(key));
    }
  }
</script>
