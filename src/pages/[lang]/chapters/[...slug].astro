---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Cyanotype from "../../../components/Cyanotype.astro";
import FallbackNotice from "../../../components/FallbackNotice.astro";
import { langs, type Lang } from "../../../i18n/ui";
import { entrySlug, formatDate, getAlternates, getLocalizedEntries, localePath, useTranslations } from "../../../i18n/utils";
import { toRoman } from "../../../lib/roman";

export async function getStaticPaths() {
  const perLang = await Promise.all(
    langs.map(async (lang) => {
      const items = (await getLocalizedEntries("chapters", lang)).sort((a, b) => a.entry.data.chapter - b.entry.data.chapter);
      const link = (it?: (typeof items)[number]) =>
        it && { href: localePath(lang, `chapters/${entrySlug(it.entry.id)}`), title: it.entry.data.title, chapter: it.entry.data.chapter };
      return items.map(({ entry, fallback }, i) => ({
        params: { lang, slug: entrySlug(entry.id) },
        props: { entry, fallback, prev: link(items[i - 1]), next: link(items[i + 1]) },
      }));
    }),
  );
  return perLang.flat();
}

const { entry, fallback, prev, next } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { Content } = await render(entry);
const d = entry.data;
const alternates = await getAlternates("chapters", "chapters", d.translationKey);
---

<Base lang={lang} canonicalPath={fallback ? alternates.en : undefined} title={d.title} description={d.summary} alternates={alternates} runningHead={`${t("chapter.label")} ${toRoman(d.chapter)}. ${d.title}`} ogType="article" section="chapters">
  <article data-reading lang={fallback ? "en" : lang}>
    <header class="mx-auto grid max-w-6xl gap-8 px-4 pt-12 pb-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-14 lg:pt-20">
      <div>
        <p class="chapter-opener">
          <span class="ui block text-sm text-ink-soft">{t("chapter.label")} <span class="sr-only">{d.chapter}</span></span>
          <span class="chapter-numeral display" aria-hidden="true">{toRoman(d.chapter)}</span>
        </p>
        <h1 class="display mt-4 text-[clamp(2.4rem,6vw,4.6rem)] text-balance">{d.title}</h1>
        <p class="mt-5 max-w-2xl text-xl leading-snug text-ink-soft italic text-pretty">{d.subtitle}</p>
        {fallback && <FallbackNotice lang={lang} />}
        <dl class="ui mt-10 grid max-w-2xl grid-cols-2 gap-x-6 gap-y-5 border-t border-rule pt-5 text-sm sm:grid-cols-3">
          <div>
            <dt class="text-ink-soft">{t("chapter.period")}</dt>
            <dd class="mt-1">{d.period}</dd>
          </div>
          {
            d.role && (
              <div>
                <dt class="text-ink-soft">{t("chapter.role")}</dt>
                <dd class="mt-1">{d.role}</dd>
              </div>
            )
          }
          <div class="col-span-2 sm:col-span-1">
            <dt class="text-ink-soft">{t("chapter.stack")}</dt>
            <dd class="mt-1">{d.stack.join(", ")}</dd>
          </div>
        </dl>
      </div>
      {d.cover && <Cyanotype src={d.cover} alt="" class="frontispiece aspect-[4/5] rounded-[4px] max-lg:hidden" loading="eager" />}
    </header>

    {
      d.outcomes.length > 0 && (
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <ul class="outcomes ui grid grid-cols-2 border-y border-rule sm:grid-cols-4" aria-label={t("chapter.outcomes")}>
            {d.outcomes.map((o) => (
              <li class="py-5 pr-4">
                <span class="display block text-3xl">{o.value}</span>
                <span class="mt-1 block text-sm text-ink-soft">{o.label}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="chapter-body prose-book mx-auto max-w-6xl px-4 pt-12 sm:px-6">
      <Content />
    </div>

    <nav class="turn ui mx-auto mt-20 grid max-w-6xl gap-px border-y border-rule px-4 sm:grid-cols-2 sm:px-6" aria-label="Chapters">
      {
        prev ? (
          <a href={prev.href} class="turn-link" rel="prev">
            <span class="text-sm text-ink-soft">{t("chapter.prev")}</span>
            <span class="font-serif text-xl text-ink">{toRoman(prev.chapter)}. {prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={next.href} class="turn-link sm:text-right" rel="next">
            <span class="text-sm text-ink-soft">{t("chapter.next")}</span>
            <span class="font-serif text-xl text-ink">{toRoman(next.chapter)}. {next.title}</span>
          </a>
        ) : (
          <p class="turn-link font-serif text-ink-soft italic sm:text-right">{t("chapter.end")}</p>
        )
      }
    </nav>
    <p class="ui mx-auto mt-6 max-w-6xl px-4 text-sm text-ink-soft sm:px-6">
      {t("post.published")} {formatDate(d.date, lang)}
    </p>
  </article>
</Base>

<style>
  .chapter-numeral {
    display: block;
    margin-top: 0.2rem;
    font-size: clamp(4rem, 9vw, 7rem);
    font-weight: 200;
    line-height: 0.9;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  /* Text runs in a book-width column; plates and scrollytelling use the full spread. */
  .chapter-body > :global(*) {
    max-width: 40rem;
    margin-inline: auto;
  }
  .chapter-body > :global(.scrolly) {
    max-width: none;
  }
  .chapter-body > :global(figure.plate) {
    max-width: 52rem;
    margin-block: 3rem;
  }
  .turn-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.6rem 0;
    text-decoration: none;
  }
  .turn-link:hover span:last-child {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-underline-offset: 0.2em;
  }
  a.turn-link[rel="next"] {
    view-transition-name: page-turn;
  }
</style>
