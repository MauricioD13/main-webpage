---
import { render } from "astro:content";
import { getImage } from "astro:assets";
import { articleLd } from "../../../lib/seo";
import Base from "../../../layouts/Base.astro";
import MonoImage from "../../../components/MonoImage.astro";
import FallbackNotice from "../../../components/FallbackNotice.astro";
import { langs, type Lang } from "../../../i18n/ui";
import { entrySlug, formatDate, getAlternates, getLocalizedEntries, localePath, readingMinutes, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  const perLang = await Promise.all(
    langs.map(async (lang) =>
      (await getLocalizedEntries("stories", lang)).map(({ entry, fallback }) => ({ params: { lang, slug: entrySlug(entry.id) }, props: { entry, fallback } })),
    ),
  );
  return perLang.flat();
}

const { entry, fallback } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { Content } = await render(entry);
const d = entry.data;
const alternates = await getAlternates("stories", "stories", d.translationKey);
const og = d.cover ? (await getImage({ src: d.cover, width: 1200, height: 630, fit: "cover", format: "jpg" })).src : undefined;
const ld = articleLd({ site: Astro.site!, url: new URL(Astro.url.pathname, Astro.site), lang, type: "BlogPosting", headline: d.title, description: d.description, datePublished: d.date, image: og, keywords: d.tags });
---

<Base lang={lang} title={d.title} description={d.description} alternates={alternates} ogType="article" ogImage={og} jsonLd={ld} section="stories" canonicalPath={fallback ? alternates.en : undefined}>
  <article data-reading lang={fallback ? "en" : lang}>
    <header class="theme-dark">
      <div class="wrap pt-16 pb-14 lg:pt-24">
        <a href={localePath(lang, "stories")} class="pill no-underline">{t("post.back")} {t("nav.stories").toLowerCase()}</a>
        <h1 class="display mt-8 max-w-5xl text-[clamp(2.6rem,6.5vw,6.4rem)]">{d.title}</h1>
        <p class="display-serif mt-5 max-w-3xl text-[clamp(1.4rem,2.4vw,2.2rem)] text-muted">{d.description}</p>
        <p class="label mt-8 flex flex-wrap gap-x-5 gap-y-1">
          <span>{t("post.by")} {t("site.title")}</span>
          <time datetime={d.date.toISOString()}>{formatDate(d.date, lang, { day: "numeric" })}</time>
          <span>{readingMinutes(entry.body)} {t("stories.read")}</span>
          {d.tags.length > 0 && <span>{d.tags.join(", ")}</span>}
        </p>
        {fallback && <FallbackNotice lang={lang} />}
      </div>
      {d.cover && <MonoImage src={d.cover} alt="" class="h-[clamp(14rem,38vw,30rem)]" loading="eager" sizes="100vw" />}
    </header>
    <div class="theme-light">
      <div class="wrap pt-16 pb-24">
        <div class="prose-site mx-auto max-w-[44rem]">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>
