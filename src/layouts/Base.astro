---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { langs, type Lang } from "../i18n/ui";
import { localePath, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** URL of this page in each locale; defaults to each locale's home. */
  alternates?: Partial<Record<Lang, string>>;
  /** Shown in the header once the reader scrolls, like a book's running head. */
  runningHead?: string;
  ogType?: "website" | "article";
  /** Active top-level section for the nav. */
  section?: "chapters" | "stories" | "books";
  /** Untranslated fallback pages point search engines at the original. */
  canonicalPath?: string;
}

const { lang, title, description, alternates = {}, runningHead, ogType = "website", section, canonicalPath } = Astro.props;
const t = useTranslations(lang);
const siteTitle = t("site.title");
const fullTitle = title ? `${title} | ${siteTitle}` : `${siteTitle}, ${t("site.author")}`;
const desc = description ?? t("site.description");
const altUrls = Object.fromEntries(langs.map((l) => [l, alternates[l] ?? localePath(l)])) as Record<Lang, string>;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(altUrls[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(altUrls.en, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={localePath(lang, "rss.xml").replace(/\/$/, "")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta name="theme-color" content="#1c3f73" />
    <Font cssVariable="--font-literata" preload />
    <Font cssVariable="--font-archivo" />
    <script is:inline>
      // Apply the saved reading light before first paint.
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "day" || saved === "night") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="ui sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-paper focus:px-3 focus:py-2">
      {t("nav.skip")}
    </a>
    <Header lang={lang} alternates={altUrls} runningHead={runningHead} section={section} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import { initSmoothScroll } from "../scripts/motion";
      initSmoothScroll();
    </script>
  </body>
</html>
